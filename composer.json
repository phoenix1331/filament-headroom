{
    "name": "phoenix1331/filament-headroom",
    "description": "A Filament dashboard for AI token usage, cost and context limits, powered by Headroom.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "ai",
        "llm",
        "headroom",
        "tokens",
        "token-usage",
        "cost-tracking",
        "context-window",
        "dashboard",
        "laravel-ai-sdk"
    ],
    "homepage": "https://phoenix1331.github.io/filament-headroom",
    "license": "MIT",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/filament-headroom/issues",
        "source": "https://github.com/phoenix1331/filament-headroom"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "phoenix1331/laravel-ai-headroom": "^0.1",
        "phoenix1331/laravel-ai-headroom-ledger": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\FilamentHeadroom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\FilamentHeadroom\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\FilamentHeadroom\\FilamentHeadroomServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "check": [
            "@lint:test",
            "@analyse",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Fix code style with Pint",
        "lint:test": "Check code style with Pint without changing files",
        "analyse": "Run Larastan at max level over src/",
        "test": "Run the Pest suite",
        "test:coverage": "Run the Pest suite with the 90% coverage gate on src/",
        "check": "Run style check, static analysis and coverage gate",
        "clear": "Reset the Testbench skeleton",
        "prepare": "Discover package providers in the Testbench skeleton",
        "build": "Build the workbench: publish assets, migrate and seed demo data",
        "serve": "Build the workbench and serve the demo panel"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0"
    }
}
